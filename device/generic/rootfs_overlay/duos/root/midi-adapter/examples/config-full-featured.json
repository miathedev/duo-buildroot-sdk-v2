{
  "description": "Full Featured - All devices with multiple routing profiles",
  "version": "2.0",
  
  "devices": {
    "usb_midi": {
      "type": "usb_midi",
      "enabled": true,
      "alias": "USB_MIDI",
      "comment": "USB MIDI input device"
    },
    "din_midi": {
      "type": "uart_midi",
      "enabled": true,
      "device": "/dev/ttyS4",
      "baudrate": 31250,
      "alias": "DIN_MIDI",
      "comment": "Hardware UART for DIN MIDI"
    },
    "network_midi_studio": {
      "type": "network_midi_rtp",
      "enabled": true,
      "target_ip": "",
      "port": 5004,
      "multicast": false,
      "alias": "NET_STUDIO",
      "comment": "Network MIDI server"
    },
    "gpio_pedal": {
      "type": "gpio_input",
      "enabled": true,
      "gpio": 466,
      "pull": "up",
      "trigger": "falling",
      "debounce_ms": 50,
      "alias": "PEDAL_1",
      "action": "toggle_routing",
      "target": "all",
      "comment": "Footpedal for routing control"
    },
    "gpio_button2": {
      "type": "gpio_input",
      "enabled": true,
      "gpio": 467,
      "pull": "up",
      "trigger": "falling",
      "debounce_ms": 50,
      "alias": "BUTTON_2",
      "action": "reconnect",
      "target": "all",
      "comment": "Button for reconnecting devices"
    }
  },
  
  "routing_profiles": {
    "default": {
      "enabled": true,
      "description": "All inputs to all outputs",
      "routes": [
        {
          "source": "usb_midi",
          "destination": "din_midi",
          "enabled": true,
          "comment": "USB to DIN MIDI"
        },
        {
          "source": "usb_midi",
          "destination": "network_midi_studio",
          "enabled": true,
          "comment": "USB to Network MIDI"
        }
      ]
    },
    "studio": {
      "enabled": false,
      "description": "Studio setup with bidirectional network MIDI",
      "routes": [
        {
          "source": "usb_midi",
          "destination": "network_midi_studio",
          "enabled": true
        },
        {
          "source": "network_midi_studio",
          "destination": "usb_midi",
          "enabled": true,
          "comment": "Bidirectional routing"
        },
        {
          "source": "usb_midi",
          "destination": "din_midi",
          "enabled": true
        }
      ]
    }
  },
  
  "settings": {
    "active_profile": "default",
    "auto_connect": true,
    "reconnect_interval_sec": 5,
    "log_level": "INFO"
  }
}
