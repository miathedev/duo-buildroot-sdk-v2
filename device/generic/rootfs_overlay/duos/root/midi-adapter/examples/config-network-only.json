{
  "description": "Network MIDI Only - USB MIDI to Network MIDI bridge",
  "version": "2.0",
  
  "devices": {
    "usb_midi": {
      "type": "usb_midi",
      "enabled": true,
      "alias": "USB_MIDI",
      "comment": "USB MIDI input device"
    },
    "network_midi_studio": {
      "type": "network_midi_rtp",
      "enabled": true,
      "target_ip": "",
      "port": 5004,
      "multicast": false,
      "alias": "NET_STUDIO",
      "comment": "Network MIDI server mode - clients connect to board IP"
    }
  },
  
  "routing_profiles": {
    "default": {
      "enabled": true,
      "description": "Simple USB to Network routing",
      "routes": [
        {
          "source": "usb_midi",
          "destination": "network_midi_studio",
          "enabled": true,
          "comment": "Route USB MIDI to Network MIDI"
        }
      ]
    }
  },
  
  "settings": {
    "active_profile": "default",
    "auto_connect": true,
    "log_level": "INFO"
  }
}
