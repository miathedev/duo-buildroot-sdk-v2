#!/bin/sh
### BEGIN INIT INFO
# Provides:          midi-webui
# Required-Start:    $network $local_fs midi-adapter
# Required-Stop:     $network $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: MIDI Adapter Web UI
# Description:       Web-based configuration interface for MIDI Adapter
### END INIT INFO

DAEMON=/root/midi-adapter/webui/app.py
PIDFILE=/var/run/midi-webui.pid
LOGFILE=/var/log/midi-webui.log

case "$1" in
  start)
    echo "Starting MIDI Adapter Web UI..."
    
    # Make script executable
    chmod +x $DAEMON
    
    # Check if Flask is available
    if ! python3 -c "import flask" 2>/dev/null; then
      echo "Warning: Flask is not installed. Web UI will not start."
      echo "Install Flask with: pip3 install flask"
      exit 1
    fi
    
    # Start the web UI in background with logging
    start-stop-daemon --start --background --make-pidfile --pidfile $PIDFILE \
      --exec /usr/bin/python3 -- $DAEMON >> $LOGFILE 2>&1
    
    echo "MIDI Adapter Web UI started on http://0.0.0.0:8080"
    ;;
    
  stop)
    echo "Stopping MIDI Adapter Web UI..."
    start-stop-daemon --stop --pidfile $PIDFILE --retry 10
    rm -f $PIDFILE
    echo "MIDI Adapter Web UI stopped"
    ;;
    
  restart)
    $0 stop
    sleep 2
    $0 start
    ;;
    
  status)
    if [ -f $PIDFILE ]; then
      PID=$(cat $PIDFILE)
      if ps -p $PID > /dev/null 2>&1; then
        echo "MIDI Adapter Web UI is running (PID: $PID)"
      else
        echo "MIDI Adapter Web UI is not running (stale PID file)"
      fi
    else
      echo "MIDI Adapter Web UI is not running"
    fi
    ;;
    
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac

exit 0
