#!/bin/sh
### BEGIN INIT INFO
# Provides:          midi-adapter
# Required-Start:    $network $local_fs
# Required-Stop:     $network $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: MIDI Adapter for MilkV Duo S
# Description:       USB MIDI to DIN MIDI and Network MIDI adapter
### END INIT INFO

DAEMON=/root/midi-adapter/midi_adapter.py
PIDFILE=/var/run/midi-adapter.pid
LOGFILE=/var/log/midi-adapter.log
CONFIG=/root/midi-adapter/config.json

case "$1" in
  start)
    echo "Starting MIDI Adapter..."
    
    # Make script executable
    chmod +x $DAEMON
    
    # Check if config exists
    if [ ! -f "$CONFIG" ]; then
      echo "Error: Configuration file not found at $CONFIG"
      exit 1
    fi
    
    # Start the adapter in background with logging
    start-stop-daemon --start --background --make-pidfile --pidfile $PIDFILE \
      --exec /usr/bin/python3 -- $DAEMON $CONFIG >> $LOGFILE 2>&1
    
    echo "MIDI Adapter started"
    ;;
    
  stop)
    echo "Stopping MIDI Adapter..."
    start-stop-daemon --stop --pidfile $PIDFILE --retry 10
    rm -f $PIDFILE
    echo "MIDI Adapter stopped"
    ;;
    
  restart)
    $0 stop
    sleep 2
    $0 start
    ;;
    
  reload)
    echo "Reloading MIDI Adapter configuration..."
    if [ -f $PIDFILE ]; then
      PID=$(cat $PIDFILE)
      if ps -p $PID > /dev/null 2>&1; then
        kill -HUP $PID
        echo "Configuration reload signal sent"
      else
        echo "MIDI Adapter is not running"
        exit 1
      fi
    else
      echo "MIDI Adapter is not running"
      exit 1
    fi
    ;;
    
  status)
    if [ -f $PIDFILE ]; then
      PID=$(cat $PIDFILE)
      if ps -p $PID > /dev/null 2>&1; then
        echo "MIDI Adapter is running (PID: $PID)"
      else
        echo "MIDI Adapter is not running (stale PID file)"
      fi
    else
      echo "MIDI Adapter is not running"
    fi
    ;;
    
  *)
    echo "Usage: $0 {start|stop|restart|reload|status}"
    exit 1
    ;;
esac

exit 0
