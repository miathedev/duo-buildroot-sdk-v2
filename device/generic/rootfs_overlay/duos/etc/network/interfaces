# Network interfaces configuration for MilkV Duo S MIDI Adapter

# Loopback interface
auto lo
iface lo inet loopback

# Ethernet interface with DHCP
auto eth0
iface eth0 inet dhcp
    hostname milkv-duos-midi
    
